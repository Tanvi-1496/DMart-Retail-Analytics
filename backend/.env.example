# Supabase PostgreSQL Connection URL
# Replace with your actual Supabase connection pooler or direct connection string:
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=

# Frontend Origins (CORS whitelist)
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8443,http://127.0.0.1:8443

# Backend Server Configuration
API_HOST=127.0.0.1
API_PORT=8000

# Path to local datasets directory
DATA_DIR=../data

# Automatically seed warehouse from data/dmart_sample_data.csv on startup if empty
SEED_ON_STARTUP=true
